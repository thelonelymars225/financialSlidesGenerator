APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
# Comma-separated exact frontend origins accepted by the hosted API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set at frontend build time when the API is hosted on another origin.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Add provider credentials only to .env; never commit real values.
# Use deterministic (default), deepseek, or openai-compatible.
MODEL_PROVIDER=deterministic
# DeepSeek defaults: https://api.deepseek.com and deepseek-v4-flash.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=8192
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
# Operator assertion: verify this in the provider account before setting true.
MODEL_DATA_RETENTION_DISABLED=false
DATABASE_URL=
OBJECT_STORAGE_URL=

# Production persistence. Keep SUPABASE_SECRET_KEY server-side only.
FINANCIAL_SLIDES_STORE=sqlite
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SOURCE_BUCKET=source-documents
SUPABASE_PRESENTATION_BUCKET=generated-presentations
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_REQUIRED=false

# Durable orchestration. Production should use Temporal Cloud in the same EU region.
WORKFLOW_BACKEND=local
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE=financial-slides-extraction-v1

# Per-organization abuse control and request limits.
JOB_SUBMISSIONS_PER_ORG_HOUR=60
API_MAX_BODY_BYTES=37748736
FORWARDED_ALLOW_IPS=127.0.0.1

# Secretless durable baseline used when FINANCIAL_SLIDES_STORE=sqlite.
FINANCIAL_SLIDES_JOB_DB=.data/extraction-jobs.sqlite3
FINANCIAL_SLIDES_SOURCE_RETENTION_HOURS=24
FINANCIAL_SLIDES_ARTIFACT_RETENTION_HOURS=24
