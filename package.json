{
  "name": "financial-slides-generator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "uv run --package financial-slides-api uvicorn financial_slides_api.main:app --reload --port 8000",
    "dev:worker": "uv run --package financial-slides-api python -m financial_slides_api.worker --watch --limit 4",
    "dev:web": "pnpm --filter @financial-slides/web dev",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check && uv run --all-packages ruff check services",
    "test": "pnpm test:web && pnpm test:packages && pnpm test:api && pnpm test:worker",
    "test:web": "pnpm --filter @financial-slides/web test",
    "test:packages": "pnpm --filter './packages/**' --if-present test",
    "test:api": "uv run --package financial-slides-api pytest services/api/tests",
    "test:worker": "uv run --package financial-slides-worker pytest services/worker/tests",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
