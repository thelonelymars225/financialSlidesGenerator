# syntax=docker/dockerfile:1.7

FROM node:22.16.0-bookworm-slim AS node-dependencies
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/extraction-benchmark/package.json packages/extraction-benchmark/package.json
COPY packages/presentation-harness/package.json packages/presentation-harness/package.json
COPY packages/presentation-renderer/package.json packages/presentation-renderer/package.json
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

FROM ghcr.io/astral-sh/uv:0.8.14 AS uv

FROM python:3.12.11-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FINANCIAL_SLIDES_REPOSITORY_ROOT=/app \
    FINANCIAL_SLIDES_JOB_DB=/var/lib/financial-slides/extraction-jobs.sqlite3 \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app

COPY --from=uv /uv /uvx /usr/local/bin/
COPY --from=node-dependencies /usr/local/bin/node /usr/local/bin/node
COPY package.json pyproject.toml uv.lock ./
COPY services/api/pyproject.toml services/api/pyproject.toml
COPY services/worker/pyproject.toml services/worker/pyproject.toml
COPY services/api/src services/api/src
COPY services/worker/src services/worker/src
COPY packages/contracts packages/contracts
COPY packages/presentation-harness packages/presentation-harness
COPY packages/presentation-renderer packages/presentation-renderer
COPY --from=node-dependencies /app/node_modules /app/node_modules
COPY --from=node-dependencies /app/packages/presentation-renderer/node_modules /app/packages/presentation-renderer/node_modules
RUN apt-get update \
    && apt-get install --no-install-recommends --yes tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && uv sync --frozen --no-dev --package financial-slides-api \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /app app \
    && mkdir -p /var/lib/financial-slides \
    && chown app:app /var/lib/financial-slides

USER app
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn financial_slides_api.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=${FORWARDED_ALLOW_IPS:-127.0.0.1}"]
