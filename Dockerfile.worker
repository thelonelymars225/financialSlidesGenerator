# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:0.8.14 AS uv

FROM python:3.12.11-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FINANCIAL_SLIDES_JOB_DB=/var/lib/financial-slides/extraction-jobs.sqlite3 \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app

COPY --from=uv /uv /uvx /usr/local/bin/
RUN apt-get update \
    && apt-get install --no-install-recommends --yes tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*
COPY package.json pyproject.toml uv.lock ./
COPY services/api/pyproject.toml services/api/pyproject.toml
COPY services/worker/pyproject.toml services/worker/pyproject.toml
COPY services/api/src services/api/src
COPY services/worker/src services/worker/src
COPY packages/contracts packages/contracts
RUN uv sync --frozen --no-dev --package financial-slides-api \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /app app \
    && mkdir -p /var/lib/financial-slides \
    && chown app:app /var/lib/financial-slides

USER app
CMD ["sh", "-c", "if [ \"${WORKFLOW_BACKEND:-local}\" = temporal ]; then exec python -m financial_slides_api.temporal_worker; else exec python -m financial_slides_api.worker --watch --limit 4; fi"]
