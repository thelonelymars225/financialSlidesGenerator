{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financialslidesgenerator.local/schemas/analysis-v0.2.schema.json",
  "title": "Analysis v0.2",
  "description": "Provider-neutral, evidence-grounded financial analysis for presentation planning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisId",
    "sourceDocumentIds",
    "executiveSummary",
    "metrics",
    "findings",
    "slideIntents"
  ],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "analysisId": { "$ref": "#/$defs/id" },
    "sourceDocumentIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "executiveSummary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric" }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    },
    "slideIntents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slideIntent" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "startDate", "endDate"],
      "properties": {
        "type": { "enum": ["instant", "month", "quarter", "year", "range"] },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "scaleFactor"],
      "properties": {
        "kind": { "enum": ["currency", "percentage", "count", "ratio"] },
        "code": { "$ref": "#/$defs/nonEmptyString" },
        "scaleFactor": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "currency" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "percentage" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "code": { "const": "%" },
              "scaleFactor": { "const": 0.01 }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "count" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "code": { "const": "count" },
              "scaleFactor": { "const": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "ratio" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "code": { "const": "ratio" },
              "scaleFactor": { "const": 1 }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "pageNumber", "blockId"],
      "properties": {
        "documentId": { "$ref": "#/$defs/id" },
        "pageNumber": { "type": "integer", "minimum": 1 },
        "blockId": { "$ref": "#/$defs/id" },
        "quote": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "operandMetricIds"],
      "properties": {
        "operation": {
          "enum": ["sum", "difference", "ratio", "percentage_change"]
        },
        "operandMetricIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "displayedValue",
        "value",
        "normalizedValue",
        "unit",
        "period",
        "evidence",
        "confidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "displayedValue": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "type": "number" },
        "normalizedValue": { "type": "number" },
        "unit": { "$ref": "#/$defs/unit" },
        "period": { "$ref": "#/$defs/period" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "calculation": { "$ref": "#/$defs/calculation" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "statement",
        "metricIds",
        "evidence",
        "confidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": ["fact", "trend", "risk", "opportunity", "recommendation"]
        },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "statement": { "$ref": "#/$defs/nonEmptyString" },
        "metricIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "slideIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "title",
        "findingIds",
        "metricIds",
        "preferredVisual",
        "priority"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "purpose": {
          "enum": [
            "executive_summary",
            "kpi",
            "trend",
            "comparison",
            "risk",
            "opportunity",
            "recommendation",
            "appendix"
          ]
        },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "findingIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "metricIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "preferredVisual": {
          "enum": ["none", "kpi", "table", "line", "bar", "waterfall"]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    }
  }
}
